{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "minimumReleaseAge": "14 days",
  "extends": ["github>elastic/renovate-config"],
  "baseBranchPatterns": ["master"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "description": "EMS CI agent images: tag is a build number, not semver; internal image with no release timestamp",
      "matchPackageNames": [
        "docker.elastic.co/ci-agent-images/ems/buildkite-agent-node24",
        "docker.elastic.co/ci-agent-images/ems/playwright"
      ],
      "versioning": "numeric",
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": true
    },
    {
      "description": "Hold maplibre-gl at the version Kibana uses (elastic/kibana#301722). Remove once Kibana moves on.",
      "matchPackageNames": ["maplibre-gl"],
      "allowedVersions": "6.4.1"
    },
    {
      "description": "Master branch specific rules",
      "matchBaseBranches": ["master"],
      "labels": ["dependencies", "v8.8.0"]
    }
  ]
}
